{
    "layer": "top",
    "position": "bottom",
    "height": 32,
    "spacing": 5,
    "margin-bottom": 2,
    "modules-left": ["sway/workspaces"],
    "modules-center": ["clock"],
    "modules-right": ["idle_inhibitor", "cpu", "memory", "custom/lenovo-battery", "battery", "pulseaudio", "tray"],

    "cpu": {
        "interval": 10,
        "format": "󰻠 {usage}%"
    },
    "memory": {
        "interval": 30,
        "format": "󰍛 {used}GB"
    },

    "battery": {
    "states": {
        "good": 80,
        "warning": 30,
        "critical": 15
    },
    "format": "{icon} {capacity}%",
    "format-charging": "{icon} {capacity}%",
    "format-alt": "{time} {icon}",
    "format-icons": {
      "default": ["󰁺", "󰁽", "󰁿", "󰂁", "󰁹"],
      "charging": ["󰁻", "󰁽", "󰁿", "󰂁", "󰂄"]
    },
    "tooltip": true
},
    "pulseaudio": {
    "format": "{icon}  {volume}%",
    "format-bluetooth": " {icon} {volume}%",
    "format-muted": "  Silenciado",
    "format-icons": {
        "headphone": "",
        "hands-free": "",
        "headset": "",
        "default": ["", "󰖀", "󰕾"]
    },
    "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
    "on-click-right": "pavucontrol",
    "tooltip": true
},
    "clock": {
        "format": "{:%d %b %Y - %H:%M %p}"
    },
    "custom/lenovo-battery": {
        "exec": "~/.config/waybar/scripts/battery-mode.sh",
        "interval": 5,
        "format": "{}",
        "signal": 10,
        "on-click": "echo 1 | sudo /usr/bin/tee /sys/bus/platform/drivers/ideapad_acpi/VPC2004:00/conservation_mode && pkill -RTMIN+10 waybar",
        "on-click-right": "echo 0 | sudo /usr/bin/tee /sys/bus/platform/drivers/ideapad_acpi/VPC2004:00/conservation_mode && pkill -RTMIN+10 waybar"
    },

    "custom/vpn": {
    "format": "{}",
    "return-type": "json",
    "interval": 5,
    "exec": "/home/julio/.config/waybar/scripts/vpn_status.sh",
    "on-click": "/home/julio/.config/waybar/scripts/vpn_menu.sh",
    "on-click-right": "nmcli connection down $(nmcli -t -f NAME,TYPE connection show --active | grep wireguard | cut -d: -f1)",
    "tooltip": false
},
"idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
        "activated": "󰫢",
        "deactivated": "󰫣"
    }
}
}
